# MongoDB connection string (MongoDB Atlas free tier or local mongod)
# Example Atlas: mongodb+srv://user:password@cluster.mongodb.net/snarenet
MONGODB_URI=mongodb://localhost:27017/snarenet

# Use a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Cookie options
NODE_ENV=development
JWT_COOKIE_NAME=snarenet_token

# First admin credentials (used only by `npm run create-admin`)
ADMIN_EMAIL=admin@snarenet.org
ADMIN_PASSWORD=ChangeMe123!

# Frontend origin for CORS (Vercel production URL, no trailing slash)
CLIENT_URL=http://localhost:5173

# Optional: public URL of this API used to build absolute URLs for uploaded images.
# Leave empty to derive it from each request (http://localhost:5000 in dev).
PUBLIC_BASE_URL=

# No secrets below this line should ever reach the frontend